{
  "name": "pathmap",
  "version": "1.0.0",
  "description": "GPX track mapping with convex hull polygons",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dual": "bash scripts/build-dual.sh",
    "preview": "vite preview",
    "preview:dual": "node scripts/serve-static.js dist-dual 4173 127.0.0.1 /pathmap/",
    "test": "npm run test:unit && npm run build && playwright test",
    "test:v2": "npm run test:unit && PATHMAP_DIST=dist-dual PATHMAP_BASE=/pathmap/v2/ playwright test",
    "test:unit": "node tests/unit/geometry.test.js",
    "review:editor": "node scripts/capture-editor-review.cjs"
  },
  "dependencies": {
    "dom-to-image-more": "^3.7.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
